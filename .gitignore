# ---------------------------------------------------------------------------
# Native build products
#
# The .so files in jniLibs are produced by ../Makefile (see README.developers)
# and are intentionally not tracked: they are ~40 MB of binaries.  The source
# of everything is in this repo (app code, liblimbo, QEMU patch series).
# ---------------------------------------------------------------------------
limbo-android-lib/src/main/jniLibs/**/*.so
limbo-android-x86/src/main/jniLibs/**/*.so
obj/
libs/
/extra/
limbotest
QEMU_VERSION

# Downloaded/extracted dependency sources (see jni/.gitignore)
# (kept there so the jni directory stays self-contained)

# Old out-of-tree QEMU trees from the 5.1 era
/limbo-android-lib/src/main/jni/qemu-2.9.1/
/limbo-android-lib/src/main/jni/qemu-5.1.0/
/limbo-android-lib/src/main/jni/qemu-patches/

# ---------------------------------------------------------------------------
# Release signing
#
# The keystore is a published demo key and *is* tracked on purpose so that
# other people can produce an upgrade-compatible release APK.  Never use it
# for anything else.
# ---------------------------------------------------------------------------
!keystore/limbo-release.jks
!keystore/keystore.properties
