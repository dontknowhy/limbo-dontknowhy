diff --git a/util/oslib-posix.c b/util/oslib-posix.c
--- a/util/oslib-posix.c
+++ b/util/oslib-posix.c
@@ -61,6 +61,62 @@
 #include "qemu/memalign.h"
 #include "qemu/mmap-alloc.h"
 
+/*
+ * Android/bionic does not provide POSIX shared memory.  Emulate shm_open(3)
+ * with regular files in a writable directory (based on the Termux patch).
+ */
+static const char *limbo_shm_dir(void)
+{
+    const char *dir = getenv("TMPDIR");
+
+    if (dir && *dir) {
+        return dir;
+    }
+    return "/data/data/com.max2idea.android.limbo.dontknowhy/cache";
+}
+
+static int shm_unlink(const char *name)
+{
+    g_autofree char *fname = NULL;
+
+    while (name[0] == '/') {
+        name++;
+    }
+    if (name[0] == '\0') {
+        errno = EINVAL;
+        return -1;
+    }
+    fname = g_strdup_printf("%s/%s", limbo_shm_dir(), name);
+    return unlink(fname);
+}
+
+static int shm_open(const char *name, int oflag, mode_t mode)
+{
+    g_autofree char *fname = NULL;
+    int fd;
+    int flags;
+
+    while (name[0] == '/') {
+        name++;
+    }
+    if (name[0] == '\0') {
+        errno = EINVAL;
+        return -1;
+    }
+    fname = g_strdup_printf("%s/%s", limbo_shm_dir(), name);
+    fd = open(fname, oflag, mode);
+    if (fd != -1) {
+        flags = fcntl(fd, F_GETFD, 0);
+        if (flags == -1 || fcntl(fd, F_SETFD, flags | FD_CLOEXEC) == -1) {
+            int save_errno = errno;
+            close(fd);
+            fd = -1;
+            errno = save_errno;
+        }
+    }
+    return fd;
+}
+
